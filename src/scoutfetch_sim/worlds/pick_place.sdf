<?xml version="1.0"?>
<sdf version="1.8">
  <world name="pick_place">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Bright neutral laboratory lighting. Explicit colors are important in Ogre2. -->
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.72 0.78 0.84 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.75 0.75 0.72 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.45 0.25 -0.86</direction>
    </light>

    <light name="ceiling_light_left" type="point">
      <pose>-1.2 0 2.55 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.95 0.95 1.0 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.55</constant>
        <linear>0.08</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="ceiling_light_right" type="point">
      <pose>1.6 0 2.55 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>1.0 0.96 0.90 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.55</constant>
        <linear>0.08</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- A 6 m x 5 m open laboratory. The rear is open for an unobstructed GUI view. -->
    <model name="laboratory_room">
      <static>true</static>
      <link name="room_shell">
        <collision name="floor_collision">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>6 5 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>6 5 0.05</size></box></geometry>
          <material>
            <ambient>0.55 0.58 0.62 1</ambient>
            <diffuse>0.68 0.72 0.76 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>

        <collision name="front_wall_collision">
          <pose>3.0 0 1.4 0 0 0</pose>
          <geometry><box><size>0.10 5.0 2.8</size></box></geometry>
        </collision>
        <visual name="front_wall_visual">
          <pose>3.0 0 1.4 0 0 0</pose>
          <geometry><box><size>0.10 5.0 2.8</size></box></geometry>
          <material>
            <ambient>0.78 0.80 0.82 1</ambient>
            <diffuse>0.88 0.90 0.92 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

        <collision name="left_wall_collision">
          <pose>0 2.5 1.4 0 0 0</pose>
          <geometry><box><size>6.0 0.10 2.8</size></box></geometry>
        </collision>
        <visual name="left_wall_visual">
          <pose>0 2.5 1.4 0 0 0</pose>
          <geometry><box><size>6.0 0.10 2.8</size></box></geometry>
          <material>
            <ambient>0.75 0.79 0.84 1</ambient>
            <diffuse>0.84 0.89 0.95 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

        <collision name="right_wall_collision">
          <pose>0 -2.5 1.4 0 0 0</pose>
          <geometry><box><size>6.0 0.10 2.8</size></box></geometry>
        </collision>
        <visual name="right_wall_visual">
          <pose>0 -2.5 1.4 0 0 0</pose>
          <geometry><box><size>6.0 0.10 2.8</size></box></geometry>
          <material>
            <ambient>0.75 0.79 0.84 1</ambient>
            <diffuse>0.84 0.89 0.95 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

        <!-- Blue lower-wall strip gives cameras useful visual features. -->
        <visual name="front_safety_strip">
          <pose>2.94 0 0.30 0 0 0</pose>
          <geometry><box><size>0.015 4.8 0.18</size></box></geometry>
          <material>
            <ambient>0.08 0.28 0.55 1</ambient>
            <diffuse>0.10 0.38 0.75 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>

        <visual name="left_light_fixture">
          <pose>-1.2 0 2.65 0 0 0</pose>
          <geometry><box><size>1.0 0.22 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.7 0.7 0.7 1</emissive>
          </material>
        </visual>
        <visual name="right_light_fixture">
          <pose>1.6 0 2.65 0 0 0</pose>
          <geometry><box><size>1.0 0.22 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.7 0.7 0.7 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Low solid chair used as the grasp-object support. -->
    <model name="chair">
      <static>true</static>
      <pose>1.0 0 0 0 0 0</pose>
      <link name="chair_link">
        <collision name="base_collision">
          <pose>0 0 0.19 0 0 0</pose>
          <geometry><box><size>0.42 0.45 0.38</size></box></geometry>
        </collision>
        <visual name="base_visual">
          <pose>0 0 0.19 0 0 0</pose>
          <geometry><box><size>0.42 0.45 0.38</size></box></geometry>
          <material>
            <ambient>0.10 0.24 0.42 1</ambient>
            <diffuse>0.16 0.40 0.68 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>

        <collision name="seat_collision">
          <pose>0 0 0.42 0 0 0</pose>
          <geometry><box><size>0.55 0.60 0.08</size></box></geometry>
        </collision>
        <visual name="seat_visual">
          <pose>0 0 0.42 0 0 0</pose>
          <geometry><box><size>0.55 0.60 0.08</size></box></geometry>
          <material><ambient>0.12 0.28 0.48 1</ambient><diffuse>0.20 0.48 0.80 1</diffuse><specular>0.16 0.16 0.16 1</specular></material>
        </visual>

        <collision name="back_collision">
          <pose>0.235 0 0.74 0 0 0</pose>
          <geometry><box><size>0.08 0.60 0.64</size></box></geometry>
        </collision>
        <visual name="back_visual">
          <pose>0.235 0 0.74 0 0 0</pose>
          <geometry><box><size>0.08 0.60 0.64</size></box></geometry>
          <material><ambient>0.12 0.28 0.48 1</ambient><diffuse>0.20 0.48 0.80 1</diffuse><specular>0.16 0.16 0.16 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- 抓取目标: 矿泉水瓶, 立在椅面上 (椅面 z=0.46)。
         模型原点取瓶底, 便于把瓶子放在椅面上。
         几何: 瓶身 + 圆肩 + 瓶颈 + 瓶盖, 总高约 21 cm, 瓶身直径 6.4 cm ——
         瓶颈/瓶盖的收窄轮廓让 YOLO 能把它识别为 bottle 类, 直径也在两指夹爪
         0~0.1 m 行程内。标签带高对比, 便于检测器把瓶身与背景分开。
         注意: 目前 static —— 真正夹取需要改成 dynamic 并配好摩擦与接触。 -->
    <model name="water_bottle">
      <static>false</static>
      <pose>0.88 0 0.46 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.03</mass>
          <inertia><ixx>1.2e-5</ixx><iyy>1.2e-5</iyy><izz>4.0e-6</izz></inertia>
        </inertial>

        <collision name="body_collision">
          <pose>0 0 0.0725 0 0 0</pose>
          <geometry><cylinder><radius>0.032</radius><length>0.145</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="body_visual">
          <pose>0 0 0.0725 0 0 0</pose>
          <geometry><cylinder><radius>0.032</radius><length>0.145</length></cylinder></geometry>
          <material>
            <ambient>0.60 0.76 0.82 1</ambient>
            <diffuse>0.80 0.92 0.96 1</diffuse>
            <specular>0.45 0.45 0.45 1</specular>
          </material>
        </visual>

        <!-- 标签带 (仅视觉): 高对比暖色环。COCO 预训练的 bottle 先验偏暖色标签,
             蓝色标签在 RGB 输入下置信度只有 ~0.06, 暖色标签 ~0.67。 -->
        <visual name="label_visual">
          <pose>0 0 0.085 0 0 0</pose>
          <geometry><cylinder><radius>0.0325</radius><length>0.055</length></cylinder></geometry>
          <material>
            <ambient>0.70 0.22 0.05 1</ambient>
            <diffuse>0.92 0.38 0.08 1</diffuse>
            <specular>0.20 0.20 0.20 1</specular>
          </material>
        </visual>

        <visual name="shoulder_visual">
          <pose>0 0 0.145 0 0 0</pose>
          <geometry><sphere><radius>0.030</radius></sphere></geometry>
          <material>
            <ambient>0.60 0.76 0.82 1</ambient>
            <diffuse>0.80 0.92 0.96 1</diffuse>
            <specular>0.45 0.45 0.45 1</specular>
          </material>
        </visual>

        <collision name="neck_collision">
          <pose>0 0 0.185 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.050</length></cylinder></geometry>
        </collision>
        <visual name="neck_visual">
          <pose>0 0 0.175 0 0 0</pose>
          <geometry><cylinder><radius>0.013</radius><length>0.030</length></cylinder></geometry>
          <material>
            <ambient>0.60 0.76 0.82 1</ambient>
            <diffuse>0.80 0.92 0.96 1</diffuse>
            <specular>0.45 0.45 0.45 1</specular>
          </material>
        </visual>

        <visual name="cap_visual">
          <pose>0 0 0.199 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.018</length></cylinder></geometry>
          <material>
            <ambient>0.60 0.18 0.04 1</ambient>
            <diffuse>0.85 0.30 0.06 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
