<?xml version="1.0" encoding="utf-8"?>
<!--
  Combined robot: car chassis (car_sim) + piper arm with gripper
  Maintainer-reported origin: modified RoboMaster sentry chassis + AgileX arm.
  Modifications: ScoutFetch integration. Upstream rights retained; see THIRD_PARTY_NOTICES.md.
  - Arm base (base_link) is mounted at the chassis BODY origin
  - Meshes are referenced via package:// paths (ROS convention)
    package://scoutfetch_description/meshes/chassis/  ->  car_sim/meshes/
    package://scoutfetch_description/meshes/piper/  ->  piper/meshes/
-->
<robot name="car_with_piper" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Simulation switches do not change the real robot model below. -->
  <xacro:arg name="sim_mode" default="false"/>
  <!-- Keep one model source while allowing MoveIt to avoid enormous CAD collision meshes. -->
  <xacro:arg name="planning_model" default="false"/>
  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="initial_positions_file" default="../config/initial_positions.yaml"/>
  <xacro:arg name="tcp_offset_xyz" default="0 0 0"/>
  <xacro:arg name="tcp_offset_rpy" default="0 0 0"/>

  <!-- ================================================================== -->
  <!-- CAR CHASSIS (from car_sim/urdf/car_sim.urdf)                      -->
  <!-- ================================================================== -->

  <link name="BODY">
    <inertial>
      <origin xyz="-0.00259004720498476 0.00067655820357232 -0.0538140096287424" rpy="0 0 0"/>
      <mass value="2.27568516297066"/>
      <inertia ixx="0.0059562120597256" ixy="1.31889223961593E-06" ixz="2.51283201679577E-06" iyy="0.00735196152742861" iyz="-4.0563085068629E-08" izz="0.0127389179090798"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/chassis/BODY.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <xacro:if value="$(arg planning_model)">
      <collision>
        <!-- Conservative CAD bounding box: fast and deterministic for FCL. -->
        <origin xyz="0.014397 0 -0.053986" rpy="0 0 0"/>
        <geometry><box size="0.463149 0.373000 0.099973"/></geometry>
      </collision>
    </xacro:if>
    <xacro:unless value="$(arg planning_model)">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://scoutfetch_description/meshes/chassis/BODY.STL"/></geometry>
      </collision>
    </xacro:unless>
  </link>

  <link name="F_B_R_Link">
    <inertial>
      <origin xyz="4.15811247411746E-06 -0.0387764090043724 2.34397195175429E-05" rpy="0 0 0"/>
      <mass value="0.524145303230556"/>
      <inertia ixx="0.000688541696255465" ixy="4.27349479622642E-10" ixz="1.07231824136283E-08" iyy="0.00122439446608104" iyz="8.19227070804737E-08" izz="0.000688691120821302"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/chassis/F_B_R_Link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <xacro:unless value="$(arg planning_model)">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://scoutfetch_description/meshes/chassis/F_B_R_Link.STL"/></geometry>
      </collision>
    </xacro:unless>
  </link>

  <joint name="F_B_R" type="continuous">
    <origin xyz="-0.16764 -0.16973 -0.075972" rpy="0 0 3.1416"/>
    <parent link="BODY"/>
    <child link="F_B_R_Link"/>
    <!-- The CAD rear-right frame is yawed by pi. Its local +Y points
         backwards in BODY, unlike the other three wheel axes. The simulation
         drive controller expects positive joint velocity to roll forward. -->
    <xacro:if value="$(arg sim_mode)"><axis xyz="0 -1 0"/></xacro:if>
    <xacro:unless value="$(arg sim_mode)"><axis xyz="0 1 0"/></xacro:unless>
  </joint>

  <link name="F_B_L_Link">
    <inertial>
      <origin xyz="-4.15299885625497E-06 -0.0387766610714727 2.34389243685268E-05" rpy="0 0 0"/>
      <mass value="0.524142277597696"/>
      <inertia ixx="0.00068853758424145" ixy="-3.92881396763585E-10" ixz="-1.06939732529201E-08" iyy="0.0012243872904858" iyz="8.19284767318812E-08" izz="0.000688687134517085"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/chassis/F_B_L_Link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <xacro:unless value="$(arg planning_model)">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://scoutfetch_description/meshes/chassis/F_B_L_Link.STL"/></geometry>
      </collision>
    </xacro:unless>
  </link>

  <joint name="F_B_L" type="continuous">
    <origin xyz="-0.16764 0.16974 -0.075972" rpy="0 0 0"/>
    <parent link="BODY"/>
    <child link="F_B_L_Link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="F_F_L_Link">
    <inertial>
      <origin xyz="4.15812041199004E-06 -0.0387764089921866 2.34397188730168E-05" rpy="0 0 0"/>
      <mass value="0.524145303423396"/>
      <inertia ixx="0.000688541696255438" ixy="4.27348346512295E-10" ixz="1.07231841854522E-08" iyy="0.00122439446607239" iyz="8.19227106083357E-08" izz="0.000688691120818141"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/chassis/F_F_L_Link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <xacro:unless value="$(arg planning_model)">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://scoutfetch_description/meshes/chassis/F_F_L_Link.STL"/></geometry>
      </collision>
    </xacro:unless>
  </link>

  <joint name="F_F_L" type="continuous">
    <origin xyz="0.15264 0.16974 -0.075972" rpy="0 0 0"/>
    <parent link="BODY"/>
    <child link="F_F_L_Link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="F_F_R_Link">
    <inertial>
      <origin xyz="4.15299265113522E-06 0.0387766610527853 2.34388943382846E-05" rpy="0 0 0"/>
      <mass value="0.524142276253491"/>
      <inertia ixx="0.000688537583988537" ixy="-3.92872414056818E-10" ixz="1.06939579529851E-08" iyy="0.00122438729047445" iyz="-8.19284680795588E-08" izz="0.00068868713426558"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/chassis/F_F_R_Link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <xacro:unless value="$(arg planning_model)">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://scoutfetch_description/meshes/chassis/F_F_R_Link.STL"/></geometry>
      </collision>
    </xacro:unless>
  </link>

  <joint name="F_F_R" type="continuous">
    <origin xyz="0.15264 -0.16974 -0.075972" rpy="0 0 0"/>
    <parent link="BODY"/>
    <child link="F_F_R_Link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="mid_Link">
    <inertial>
      <origin xyz="-0.000199574115905488 -6.35009226230681E-06 -0.0174674074223493" rpy="0 0 0"/>
      <mass value="1.10672092820322"/>
      <inertia ixx="0.000326022185952641" ixy="-4.30083905768617E-08" ixz="2.38151317788481E-06" iyy="0.000351603059138939" iyz="-3.50267298324671E-09" izz="0.000536638419995748"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/chassis/mid_Link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.615686274509804 0.643137254901961 0.674509803921569 1"/>
      </material>
    </visual>
    <xacro:unless value="$(arg planning_model)">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://scoutfetch_description/meshes/chassis/mid_Link.STL"/></geometry>
      </collision>
    </xacro:unless>
  </link>

  <joint name="mid360" type="fixed">
    <origin xyz="0.1325 0 0.010499" rpy="0 0 3.1416"/>
    <parent link="BODY"/>
    <child link="mid_Link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- ================================================================== -->
  <!-- CONNECTION: Mount piper arm on car chassis                         -->
  <!--   base_link is the public mobile-manipulator root. BODY is the CAD chassis frame. -->
  <!-- ================================================================== -->

  <joint name="body_to_base_link" type="fixed">
    <parent link="base_link"/>
    <child link="BODY"/>
    <origin xyz="0 0 0.004" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================== -->
  <!-- PIPER ARM (from piper_description.urdf                            -->
  <!--   All links are identical to the original except:                  -->
  <!--    - Removed <link name="world"/>                                  -->
  <!--    - Removed <joint name="world_to_base_link"/>                    -->
  <!--    - base_link is the root; BODY is its child via body_to_base_link -->
  <!-- ================================================================== -->

  <link name="base_link">
    <inertial>
      <origin xyz="-0.00473641164191482 2.56829134630247E-05 0.041451518036016" rpy="0 0 0"/>
      <mass value="1.02"/>
      <inertia ixx="0.00267433" ixy="-0.00000073" ixz="-0.00017389" iyy="0.00282612" iyz="0.0000004" izz="0.00089624"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/dae/base_link.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/base_link.stl"/>
      </geometry>
    </collision>
  </link>

  <link name="link1">
    <inertial>
      <origin xyz="0.00032 -0.00041 -0.00348" rpy="0 0 0"/>
      <mass value="0.71"/>
      <inertia ixx="0.00050027" ixy="0.00000078" ixz="0.00000626" iyy="0.00040879" iyz="0.00000462" izz="0.00045802"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/dae/link1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/link1.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.123" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6179938" upper="2.6179938" effort="100" velocity="5"/>
  </joint>

  <link name="link2">
    <inertial>
      <origin xyz="0.21852 -0.00861 0.00126" rpy="0 0 0"/>
      <mass value="1.16"/>
      <inertia ixx="0.00111915" ixy="0.00182916" ixz="0.00019233" iyy="0.06763251" iyz="0.00000767" izz="0.067559"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/dae/link2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/link2.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="1.5707963 -0.1357866 -3.1415926"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="3.1415926" effort="100" velocity="5"/>
  </joint>

  <link name="link3">
    <inertial>
      <origin xyz="-0.01999 -0.14808 -0.00053" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01347608" ixy="0.00161034" ixz="0.00000066" iyy="0.00046377" iyz="0.00000162" izz="0.01363321"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/dae/link3.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/link3.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint3" type="revolute">
    <origin xyz="0.28503 0 0" rpy="0 0 -1.7938494"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9670597" upper="0" effort="100" velocity="5"/>
  </joint>

  <link name="link4">
    <inertial>
      <origin xyz="0.00013 -0.00076 -0.00394" rpy="0 0 0"/>
      <mass value="0.38"/>
      <inertia ixx="0.00017844" ixy="0.00000062" ixz="0.00000067" iyy="0.00018914" iyz="0.00000408" izz="0.00014613"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/dae/link4.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/link4.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint4" type="revolute">
    <origin xyz="-0.02198 -0.25075 0" rpy="1.5707963 0 0"/>
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.7453292" upper="1.7453292" effort="100" velocity="5"/>
  </joint>

  <link name="link5">
    <inertial>
      <origin xyz="0.00018 -0.06104 -0.00227" rpy="0 0 0"/>
      <mass value="0.383"/>
      <inertia ixx="0.00172318" ixy="0.00000259" ixz="0.00000010" iyy="0.00017936" iyz="0.00000990" izz="0.00171172"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/dae/link5.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/link5.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint5" type="revolute">
    <origin xyz="0 0 0" rpy="-1.5707963 0 0"/>
    <parent link="link4"/>
    <child link="link5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.2217304" upper="1.2217304" effort="100" velocity="5"/>
  </joint>

  <link name="link6">
    <inertial>
      <origin xyz="-0.00003 0.00006 -0.002" rpy="0 0 0"/>
      <mass value="0.007"/>
      <inertia ixx="0.00152112" ixy="0.00000202" ixz="0.00000261" iyy="0.00138626" iyz="0.00000002" izz="0.00031152"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/dae/link6.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/link6.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint6" type="revolute">
    <origin xyz="8.8259E-05 -0.091 0" rpy="1.5707963 0 0"/>
    <parent link="link5"/>
    <child link="link6"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0943951" upper="2.0943951" effort="100" velocity="5"/>
  </joint>

  <!-- ================================================================== -->
  <!-- GRIPPER (from piper_with_gripper_description.xacro)                -->
  <!-- ================================================================== -->

  <link name="flange_link">
    <inertial>
      <origin xyz="1.151691e-03 0.782428e-03 4.798051e-03" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="9.935389e-06" ixy="0.0" ixz="0.0" iyy="10.508003e-06" iyz="0.0" izz="19.652873e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/dae/flange.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/flange.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="flange_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="link6"/>
    <child link="flange_link"/>
  </joint>

  <link name="gripper_base">
    <inertial>
      <origin xyz="-0.000183807162235591 8.05033155577911E-05 0.0321436689908876" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.00092934" ixy="0.00000034" ixz="-0.00000738" iyy="0.00071447" iyz="0.00000005" izz="0.00039442"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/dae/gripper_base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/gripper_base.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="gripper_base_joint" type="fixed">
    <origin xyz="0 0 0.0045" rpy="0 0 0"/>
    <parent link="flange_link"/>
    <child link="gripper_base"/>
  </joint>

  <link name="gripper_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="gripper" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="gripper_base"/>
    <child link="gripper_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.1" effort="10" velocity="3"/>
  </joint>

  <link name="gripper_link1">
    <inertial>
      <origin xyz="0.00065123185041968 -0.0491929869131989 0.00972258769184025" rpy="0 0 0"/>
      <mass value="0.025"/>
      <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/dae/gripper_link1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/gripper_link1.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="gripper_joint1" type="prismatic">
    <origin xyz="0 0 0.138" rpy="1.5707963 0 0"/>
    <parent link="gripper_base"/>
    <child link="gripper_link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.05" effort="10" velocity="3"/>
    <mimic joint="gripper" multiplier="0.5" offset="0.0"/>
  </joint>

  <link name="gripper_link2">
    <inertial>
      <origin xyz="0.00065123185041968 -0.0491929869131989 0.00972258769184025" rpy="0 0 0"/>
      <mass value="0.025"/>
      <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/dae/gripper_link2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://scoutfetch_description/meshes/piper/gripper_link2.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="gripper_joint2" type="prismatic">
    <origin xyz="0 0 0.138" rpy="1.5707963 0 -3.1415926"/>
    <parent link="gripper_base"/>
    <child link="gripper_link2"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.05" upper="0" effort="10" velocity="3"/>
    <mimic joint="gripper" multiplier="-0.5" offset="0.0"/>
  </joint>

  <!-- These TCP links are copied from the real piper_control model. -->
  <link name="gripper_tcp"/>
  <joint name="gripper_tcp_joint" type="fixed">
    <parent link="gripper_base"/><child link="gripper_tcp"/>
    <origin xyz="0 0 0.138" rpy="0 0 0"/>
  </joint>
  <link name="tcp_link"/>
  <joint name="tcp_joint" type="fixed">
    <parent link="link6"/><child link="tcp_link"/>
    <origin xyz="$(arg tcp_offset_xyz)" rpy="$(arg tcp_offset_rpy)"/>
  </joint>

  <!-- Frames copied from the real Mid-360 model and real hand-eye launch. -->
  <link name="livox_frame"/>
  <joint name="mid_to_livox_frame" type="fixed">
    <parent link="mid_Link"/><child link="livox_frame"/><origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="imu_frame"/>
  <joint name="imu2lidar" type="fixed">
    <parent link="livox_frame"/><child link="imu_frame"/>
    <origin xyz="0.011 0.02329 -0.04412" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <inertial><origin xyz="0 0 0"/><mass value="0.072"/>
      <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00004"/></inertial>
    <visual>
      <!-- ScoutFetch original simplified visual; no external camera mesh. -->
      <origin xyz="-0.008 0 0" rpy="0 0 0"/>
      <geometry><box size="0.016 0.09 0.025"/></geometry>
      <material name="scoutfetch_camera_shell"><color rgba="0.18 0.20 0.23 1"/></material>
    </visual>
    <!-- Original rigid L bracket, expressed in camera_link so the existing
         camera/TCP transforms stay untouched. Dimensions fit the current mount.
         Visual geometry only: no unmeasured mass or collision envelope added. -->
    <visual name="camera_bracket_backplate">
      <origin xyz="-0.020 0 0" rpy="0 0 0"/>
      <geometry><box size="0.008 0.104 0.036"/></geometry>
      <material name="scoutfetch_camera_bracket"><color rgba="0.65 0.67 0.70 1"/></material>
    </visual>
    <visual name="camera_bracket_left_arm">
      <origin xyz="-0.026 0.044 -0.030" rpy="0 0 0"/>
      <geometry><box size="0.012 0.008 0.060"/></geometry>
      <material name="scoutfetch_bracket_support"><color rgba="0.12 0.48 0.72 1"/></material>
    </visual>
    <visual name="camera_bracket_right_arm">
      <origin xyz="-0.026 -0.044 -0.030" rpy="0 0 0"/>
      <geometry><box size="0.012 0.008 0.060"/></geometry>
      <material name="scoutfetch_bracket_support"/>
    </visual>
    <visual name="camera_bracket_wrist_plate">
      <origin xyz="-0.035 0 -0.055" rpy="0 0 0"/>
      <geometry><box size="0.034 0.104 0.008"/></geometry>
      <material name="scoutfetch_bracket_support"/>
    </visual>
    <!-- Keep collision simple for stable and inexpensive simulation. -->
    <collision>
      <origin xyz="-0.008 0 0" rpy="0 0 0"/>
      <geometry><box size="0.016 0.09 0.025"/></geometry>
    </collision>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="link6"/><child link="camera_link"/>
    <!-- Rigid wrist mount: camera +X (viewing direction) aligns with link6 +Z. -->
    <origin xyz="-0.055 0 0.040" rpy="0 -1.57079632679 0"/>
  </joint>
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_color_optical_frame"/><child link="camera_depth_optical_frame"/><origin xyz="0 0 0"/>
  </joint>

  <xacro:property name="initial_positions" value="${xacro.load_yaml('$(arg initial_positions_file)')['initial_positions']}"/>
  <ros2_control name="MCArmSystem" type="system">
    <hardware>
      <xacro:if value="$(arg sim_mode)"><plugin>gz_ros2_control/GazeboSimSystem</plugin></xacro:if>
      <xacro:unless value="$(arg sim_mode)"><plugin>mock_components/GenericSystem</plugin></xacro:unless>
    </hardware>
    <joint name="F_F_L"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="F_F_R"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="F_B_L"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="F_B_R"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <xacro:macro name="arm_control_joint" params="name effort:=false">
      <joint name="${name}">
        <xacro:unless value="${effort}"><command_interface name="position"/></xacro:unless>
        <xacro:if value="${effort}"><command_interface name="effort"/></xacro:if>
        <state_interface name="position"><param name="initial_value">${initial_positions[name]}</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:arm_control_joint name="joint1"/><xacro:arm_control_joint name="joint2"/>
    <xacro:arm_control_joint name="joint3"/><xacro:arm_control_joint name="joint4"/>
    <xacro:arm_control_joint name="joint5"/><xacro:arm_control_joint name="joint6"/>
    <xacro:arm_control_joint name="gripper" effort="true"/>
    <!-- Gazebo 不实现 URDF <mimic>: 手指必须由 ros2_control 直接驱动 (effort 接口,
         以便夹到物体时受目标力限制而停住, 而不是位置伺服硬穿过去)。真机模式同样暴露
         effort 接口, 但真机由 agx_arm 驱动节点接管, 上层语义 (width/force) 不变。 -->
    <xacro:arm_control_joint name="gripper_joint1" effort="true"/>
    <xacro:arm_control_joint name="gripper_joint2" effort="true"/>
  </ros2_control>

  <xacro:if value="$(arg sim_mode)">
    <gazebo><plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin"><robot_param>robot_description</robot_param><robot_param_node>sim_robot_state_publisher</robot_param_node><parameters>$(arg controllers_file)</parameters></plugin></gazebo>
    <gazebo reference="F_F_L_Link"><mu1>1.2</mu1><mu2>0.25</mu2></gazebo>
    <gazebo reference="F_F_R_Link"><mu1>1.2</mu1><mu2>0.25</mu2></gazebo>
    <gazebo reference="F_B_L_Link"><mu1>1.2</mu1><mu2>0.25</mu2></gazebo>
    <gazebo reference="F_B_R_Link"><mu1>1.2</mu1><mu2>0.25</mu2></gazebo>
    <gazebo reference="livox_frame"><sensor name="mid360_scan" type="gpu_lidar"><topic>/scan_raw</topic><gz_frame_id>livox_frame</gz_frame_id><update_rate>10</update_rate><always_on>true</always_on><lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.05</min><max>70</max><resolution>0.01</resolution></range></lidar></sensor></gazebo>
    <gazebo reference="imu_frame"><sensor name="mid360_imu" type="imu"><topic>/livox/imu</topic><gz_frame_id>imu_frame</gz_frame_id><update_rate>200</update_rate><always_on>true</always_on></sensor></gazebo>
    <gazebo reference="camera_link"><sensor name="d435i_rgbd" type="rgbd_camera"><topic>/camera</topic><gz_frame_id>camera_color_optical_frame</gz_frame_id><update_rate>30</update_rate><always_on>true</always_on><camera><horizontal_fov>1.211</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>10</far></clip></camera></sensor></gazebo>
  </xacro:if>

</robot>
